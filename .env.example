# ───────────────────────────────────────────────────────────
# Maintenant ! — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS commit .env.local
# ───────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────
VITE_APP_NAME="Maintenant !"
VITE_APP_URL="https://maintenant.org"
VITE_APP_ENV="development"  # development | staging | production

# ── Supabase (front — VITE_ exposées dans le bundle) ──────
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# ── Stripe (front — publishable key uniquement) ───────────
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# ── Plausible / Umami (analytics RGPD-friendly) ───────────
VITE_PLAUSIBLE_DOMAIN="maintenant.org"
VITE_PLAUSIBLE_API="https://plausible.io"

# ── Sentry (monitoring) ───────────────────────────────────
VITE_SENTRY_DSN="https://xxxxxxxxxxxx@sentry.io/xxxxxxxx"

# ═══════════════════════════════════════════════════════════
# SECRETS SERVEUR — uniquement côté backend / fonctions edge
# NE JAMAIS exposer dans le bundle front
# ═══════════════════════════════════════════════════════════

# ── Supabase service role (admin DB) ──────────────────────
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# ── Stripe (serveur) ──────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ── Email transactionnel (Resend ou Postmark) ─────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="contact@maintenant.org"
EMAIL_REPLY_TO="bonjour@maintenant.org"

# ── Modération automatique (Perspective API ou similaire) ─
PERSPECTIVE_API_KEY=""

# ── Stockage media (si pas Supabase Storage) ──────────────
# CLOUDFLARE_R2_ACCOUNT_ID=""
# CLOUDFLARE_R2_ACCESS_KEY=""
# CLOUDFLARE_R2_SECRET_KEY=""

# ── Recaptcha (anti-spam formulaires publics) ─────────────
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
