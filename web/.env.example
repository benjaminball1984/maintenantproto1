# Copier ce fichier en .env.local et remplir les valeurs.
# NE JAMAIS commit .env.local

VITE_APP_NAME="Maintenant !"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# Supabase (front — clés publiques)
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# Stripe (front — publishable key uniquement)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# Analytics (RGPD-friendly)
VITE_PLAUSIBLE_DOMAIN="maintenant.org"
VITE_PLAUSIBLE_API="https://plausible.io"

# Sentry
VITE_SENTRY_DSN=""

# Recaptcha
VITE_RECAPTCHA_SITE_KEY=""

# Contact support (page /legal/contact)
# Email affiché en fallback (mailto:). Défaut : contact@maintenant.org.
VITE_SUPPORT_EMAIL=""
# UUID Supabase d'un compte support pour router les messages internes.
# Si vide, le formulaire bascule sur mailto: pour ne pas créer une conversation
# orpheline. Doit pointer sur un utilisateur public.users existant.
VITE_SUPPORT_USER_ID=""
