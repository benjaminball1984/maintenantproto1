{
  "name": "pasdepesticidespournosenfants",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pétition Pas de pesticides pour nos enfants — initiative Bio Consom'acteurs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"netlify/**/*.ts\"",
    "build:establishments": "tsx scripts/build-establishments-json.ts",
    "seed:establishments": "tsx scripts/seed-establishments.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.45.4",
